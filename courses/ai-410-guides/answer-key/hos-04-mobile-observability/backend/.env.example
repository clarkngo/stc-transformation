# Copy this file to .env and fill in your own values. Never commit .env.

# Free, no credit card required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Get this from your Upstash Redis dashboard ("Redis Connect" -> URL)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Free Langfuse project — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
