{
    "name": "AI 410 — Week 4",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "pip install -r backend/requirements.txt && cp -n backend/.env.example backend/.env",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": { "label": "Backend API", "onAutoForward": "notify" }
    },
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python"]
        }
    }
}
