# Copy this file to .env and fill in your own values. Never commit .env.

# Free, no credit card required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Get this from your Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
