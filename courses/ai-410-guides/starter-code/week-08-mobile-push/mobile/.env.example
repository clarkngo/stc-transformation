# Where your backend lives.
#
# In Codespaces: make port 8000 Public in the Ports tab, then use its
# forwarded URL:
#   EXPO_PUBLIC_API_BASE=https://your-codespace-name-8000.app.github.dev
#
# Running locally, with your phone on the same Wi-Fi as your laptop,
# use your laptop's LAN IP instead (not localhost — that means the
# phone itself, not your laptop):
#   EXPO_PUBLIC_API_BASE=http://192.168.1.23:8000
EXPO_PUBLIC_API_BASE=http://192.168.1.23:8000
