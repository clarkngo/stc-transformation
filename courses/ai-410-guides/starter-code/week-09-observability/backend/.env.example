# Copy this file to .env and fill in your own values. Never commit .env.

# Free, no credit card required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Get this from your Upstash Redis dashboard ("Redis Connect" -> URL)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Get these from your Langfuse project settings
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
