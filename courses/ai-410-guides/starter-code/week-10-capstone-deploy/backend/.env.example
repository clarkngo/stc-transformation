# Copy this file to .env and fill in your own values. Never commit .env.

# Free, no credit card required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Weeks 1-9 used an embedded Chroma database (just a local folder) —
# this week the API and worker are two separate services, so Chroma
# has to run as its own service too. Locally, run `chroma run --path
# chroma_db --port 8001` in its own terminal and leave these as-is.
# When deploying (see render.yaml), point these at the ai410-chromadb
# service instead.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Get this from your Upstash Redis dashboard ("Redis Connect" -> URL)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Get these from your Langfuse project settings
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
